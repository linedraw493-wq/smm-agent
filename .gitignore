# --- медиа выпусков: структура трекается, содержимое локально ---
projects/*/raw/
projects/*/work/
projects/*/out/

# --- общие тяжёлые ассеты: дверь и реестры трекаются, файлы локально ---
assets/*
!assets/README.md
!assets/music/
assets/music/*
!assets/music/licenses.md

# --- модели распознавания речи (сотни МБ) ---
tools/models/

# --- секреты ---
.env
*.env
!.env.example
*.key
*.pem
secrets/

# --- временное ---
scratch/
*.log

# --- python ---
__pycache__/
*.pyc
.venv/
venv/

# --- ОС / редакторы ---
.DS_Store
Thumbs.db
.obsidian/
